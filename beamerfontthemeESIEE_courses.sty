\mode<presentation>

\renewcommand{\familydefault}{\sfdefault}
\renewcommand{\mathfamilydefault}{\sfdefault}
\beamer@sansmathfalse


% Personal options --------------------------------------------------------
% Captions
\setbeamerfont{caption name}{
	shape = \upshape
}

% Headline
\setbeamerfont{headline}{
	size = \tiny
}

% Footonotes
\setbeamerfont{footnote}{
	size = \tiny,
}

% Beamer title --------------------------------------------------------
\setbeamerfont{title}{
	size=\Large,
	series = \mdseries,
	shape = \upshape
}

% Section
\setbeamerfont{newsectiontitle}{
	size=\huge,
	series = \mdseries,
	shape = \itshape
}

% Author, Institution, Date -------------------------------------------
\setbeamerfont{date}{
	size=\normalsize,
	shape = \upshape
}

\setbeamerfont{author}{
	size=\normalsize,
	shape = \scshape
}

\setbeamerfont{email}{
	size=\normalsize,
	shape = \upshape
}

\setbeamerfont{institute}{
	size=\normalsize,
	shape = \upshape
}

% Header ----------------------------------------------------------------
\setbeamerfont{subsection in head/foot}{
	size=\tiny,
	shape = \itshape
}

\mode<all>