% ---------------------------------------------------------------------
%  Header ----------------------------------------------------------
% ---------------------------------------------------------------------
\setbeamertemplate{headline}{%
  % Make sections appears in a contrasted color
  \hypersetup{linkcolor=maintext_color}
  % Create sections' line
  \begin{beamercolorbox}{section in head/foot}
  	\vskip2pt%
   	\insertsectionnavigationhorizontal{\paperwidth}{}{}%
   	\vskip2pt
  \end{beamercolorbox}%
  % If subsection is true (that is, if it is part of the headline)
   \ifbeamer@theme@subsection%
    	\vspace{-1pt}%
   	 \begin{beamercolorbox}[ht=2.5ex,dp=1.125ex,%
  	         leftskip=.3cm,rightskip=.3cm plus1fil]{subsection in head/foot}%
  	    	\usebeamerfont{subsection in head/foot}%
  	    	\insertsubsectionhead%
 	   \end{beamercolorbox}%
   \fi
}

% Footer --------------------------------------------------------------
% Define navigation symbols at the bottom of the page ;
% Erase the default symbols 
\setbeamertemplate{navigation symbols}{}

% Box
\setbeamertemplate{footline}{%
	\hypersetup{linkcolor=light_background}
	\begin{beamercolorbox}
	[center, colsep = 2px,leftskip=3px,rightskip=3px]
	{FootBox}
	\begin{minipage}{0.32\textwidth}
	\insertshorttitle
	\end{minipage}
	\hfill
	\begin{minipage}{0.32\textwidth}
	\centering
	\insertshortauthor
	\end{minipage}
	\hfill
	\begin{minipage}{0.32\textwidth}
	\raggedleft
	\insertframenumber\ / \inserttotalframenumber
	\end{minipage}
    \end{beamercolorbox}
    \vskip 0pt
}

\mode<all>